{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermInk",
  "version": "0.1.0",
  "identifier": "dev.reishi.termink",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1440",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "TermInk",
        "width": 960,
        "height": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    }
  },
  "mainBinaryName": "TermInk"
}
